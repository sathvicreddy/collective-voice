];

let auditExpandedRow = 7; // index of expanded row (last one by default — showing JSON)
let auditDateRange = 'May 12, 2024 – May 19, 2024';

function auditActionBadge(action, type) {
  const colors = {
    danger:  { bg:'#fde8e8', color:'#c0392b' },
    warning: { bg:'#fff0db', color:'#d97706' },
    info:    { bg:'#e0eaff', color:'#2966e8' },
    success: { bg:'#d6f5e8', color:'#1a9c5a' },
  };
  const c = colors[type] || colors.info;
  return `<span class="audit-action-badge" style="background:${c.bg};color:${c.color}">${action}</span>`;
}

function renderAuditLog() {
  const tableRows = MOCK_AUDIT.map((row, idx) => {
    const isExpanded = auditExpandedRow === idx;
    const detailJson = JSON.stringify(row.detail, null, 2);
    return `
    <tr class="dt-row ${isExpanded ? 'dt-row-selected' : ''}" onclick="toggleAuditRow(${idx})">
      <td class="dt-td audit-ts">${row.ts}</td>
      <td class="dt-td">
        <div style="display:flex;align-items:center;gap:8px">
          <div class="tbl-avatar" style="background:${colorForInit(row.adminInit)};color:${textColorForInit(row.adminInit)}">${row.adminInit}</div>
          <div>
            <div style="font-weight:600;font-size:13px">${row.admin}</div>
            <div style="font-size:11px;color:var(--muted)">(${row.adminRole})</div>
          </div>
        </div>
      </td>
      <td class="dt-td">${auditActionBadge(row.action, row.actionType)}</td>
      <td class="dt-td" style="color:var(--ink-secondary);font-size:13px">${row.targetType}</td>
      <td class="dt-td">
        <div style="font-size:13px;font-weight:600;color:var(--primary);max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${row.targetName}</div>
        <div style="font-size:11px;color:var(--muted)">(${row.targetId})</div>
      </td>
      <td class="dt-td">
        <div style="display:flex;align-items:center;gap:8px">
          <span style="font-size:12px;font-weight:600;color:var(--primary);cursor:pointer">view</span>
          <span style="color:var(--muted);font-size:14px">${isExpanded ? '∧' : '∨'}</span>
        </div>
      </td>
    </tr>
    ${isExpanded ? `<tr class="audit-detail-row">
      <td colspan="6">
        <div class="audit-json-wrap">
          <pre class="audit-json">${detailJson}</pre>
          <button class="audit-copy-btn" onclick="event.stopPropagation()" title="Copy JSON">${IC.copy}</button>
        </div>
      </td>
    </tr>` : ''}`;
  }).join('');

  return `
    <div class="page active" id="page-audit">
      <div class="page-header page-header-row">
        <div>
          <h1 class="page-title">Audit Log <span class="page-count">12,845 records</span></h1>
        </div>
      </div>

      <!-- Filters -->
      <div class="audit-filters">
        <div class="audit-filter-group">
          <div class="audit-filter-label">Admin</div>
          <div class="dt-search-wrap" style="min-width:160px;height:34px">
            ${IC.search}<input class="dt-search-input" placeholder="Search admin…" type="text">
            ${IC.chevronDown}
          </div>
        </div>
        <div class="audit-filter-group">
          <div class="audit-filter-label">Action type</div>
          <div class="filter-group" style="height:34px">
            <div class="filter-select-wrap">
              <select class="filter-select"><option>All actions</option><option>user.suspend</option><option>meeting.delete</option><option>system.config_update</option></select>
              ${IC.chevronDown}
            </div>
          </div>
        </div>
        <div class="audit-filter-group">
          <div class="audit-filter-label">Target type</div>
          <div class="filter-group" style="height:34px">
            <div class="filter-select-wrap">
              <select class="filter-select"><option>All target types</option><option>User</option><option>Meeting</option><option>Question</option><option>Poll</option><option>SystemConfig</option></select>
              ${IC.chevronDown}
            </div>
          </div>
        </div>
        <div class="audit-filter-group">
          <div class="audit-filter-label">Date range</div>
          <div class="audit-date-range-wrap">
            <span class="audit-date-icon">${IC.calendarRange}</span>
            <span class="audit-date-text">${auditDateRange}</span>
            <button class="audit-date-clear" onclick="event.stopPropagation()">${IC.x}</button>
          </div>
        </div>
        <button class="clear-filters-btn">Clear filters</button>
      </div>

      <!-- Table -->
      <div class="dt-layout" style="flex:1;min-height:0">
        <div class="dt-table-wrap">
          <table class="dt-table">
            <thead><tr>
              <th class="dt-th">Timestamp <span style="font-size:10px">↕</span></th>
              <th class="dt-th">Admin Name</th>
              <th class="dt-th">Action</th>
              <th class="dt-th">Target Type</th>
              <th class="dt-th">Target</th>
              <th class="dt-th">Details</th>
            </tr></thead>
            <tbody>${tableRows}</tbody>
          </table>
          <div class="dt-footer">
            <div class="dt-showing">Showing 1 to 25 of 12,845 records</div>
            <div class="pagination-row">
              <div class="pagination">
                <button class="pg-btn">${IC.chevronLeft}</button>
                <button class="pg-btn active">1</button>
                <button class="pg-btn">2</button>
                <button class="pg-btn">3</button>
                <button class="pg-btn">4</button>
                <button class="pg-btn">5</button>
                <span class="pg-ellipsis">…</span>
                <button class="pg-btn">514</button>
                <button class="pg-btn">${IC.chevronRight}</button>
              </div>
              <div class="per-page-wrap">
                <select class="filter-select"><option>25 per page</option><option>50 per page</option><option>100 per page</option></select>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>`;
}

window.toggleAuditRow = function(idx) {
  auditExpandedRow = auditExpandedRow === idx ? null : idx;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderAuditLog();
};

window.setHealthFilter = function(f) {
  healthErrorFilter = f;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderSystemHealth();
};

window.toggleHealthError = function(idx) {
  healthExpandedError = healthExpandedError === idx ? null : idx;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderSystemHealth();
};

function getPageContent(pageId) {
  switch(pageId) {
    case 'overview':   return renderOverview();
    case 'live-now':   return renderLiveNow();
    case 'users':      return renderUsers();
    case 'meetings':   return renderMeetings();
    case 'moderation': return renderContentModeration();
    case 'nlp':        return renderNLPEngine();
    case 'health':     return renderSystemHealth();
    case 'audit':      return renderAuditLog();
    default:           return renderOverview();
  }
}


/* ================================================================
   GLOBAL ACTIONS
   ================================================================ */
window.adminNavigate = function(pageId) {
  currentPage = pageId;
  document.querySelectorAll('.nav-item').forEach(el=>el.classList.toggle('active', el.dataset.page===pageId));
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = getPageContent(pageId);
  // Close any open menus
  meetingContextMenu = null;
};

window.selectMeeting = function(id) {
  selectedMeetingId = id;
  meetingContextMenu = null;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.closeMeetingPanel = function() {
  selectedMeetingId = null;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.setMeetingTab = function(tab) {
  meetingDetailTab = tab;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.toggleMeetingMenu = function(e, id) {
  e.stopPropagation();
  if(meetingContextMenu?.meetingId===id && !meetingContextMenu?.sub) {
    meetingContextMenu = null;
  } else {
    meetingContextMenu = { meetingId: id, sub: null };
    selectedMeetingId = id;
  }
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.showStatusSubmenu = function(id) {
  meetingContextMenu = { meetingId: id, sub: 'status' };
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.openDeleteModal = function(id) {
  deleteMeetingId = id;
  showDeleteModal = true;
  meetingContextMenu = null;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.closeDeleteModal = function() {
  showDeleteModal = false;
  deleteMeetingId = null;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderMeetings();
};

window.selectUser = function(id) {
  selectedUserId = id;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderUsers();
};

window.closeUserPanel = function() {
  selectedUserId = null;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderUsers();
};

window.setLiveView = function(view) {
  document.getElementById('card-view-btn')?.classList.toggle('active', view==='card');
  document.getElementById('table-view-btn')?.classList.toggle('active', view==='table');
};

window.sortLiveMeetings = function(by) {
  MOCK.liveMeetings.sort((a,b)=>{
    if(by==='participants') return b.participants-a.participants;
    if(by==='questions')    return b.questions-a.questions;
    const toSec=t=>t.split(':').reduce((acc,v)=>acc*60+ +v,0);
    return toSec(b.liveFor)-toSec(a.liveFor);
  });
  adminNavigate('live-now');
};

// Close context menu on outside click
document.addEventListener('click', () => {
  if(meetingContextMenu) {
    meetingContextMenu = null;
    const content = document.getElementById('admin-content-area');
    if(content && currentPage==='meetings') content.innerHTML = renderMeetings();
  }
});

/* ================================================================
   MOUNT
   ================================================================ */
function mount() {
  const root = document.getElementById('admin-app');
  if(!root) return;
  root.innerHTML = `
    ${renderSidebar()}
    <div class="admin-main">
      ${renderTopbar()}
      <div class="admin-content" id="admin-content-area">${getPageContent(currentPage)}</div>
    </div>`;
}

/* NLP handlers */
window.updateNlpThreshold = function(val) {
  nlpThreshold = parseFloat(val);
  const el = document.getElementById('nlp-threshold-val');
  const display = document.querySelector('.nlp-threshold-display');
  if(el) el.textContent = nlpThreshold.toFixed(2);
  if(display) display.textContent = nlpThreshold.toFixed(2);
  const slider = document.getElementById('nlp-threshold');
  if(slider) slider.style.setProperty('--pct', (nlpThreshold*100).toFixed(1)+'%');
};

window.updateNlpWeight = function(key, val) {
  nlpWeights[key] = parseFloat(val);
  const valEl = document.getElementById('nlp-' + {vote:'vote',fresh:'fresh',novel:'novel',diverse:'div'}[key] + '-val');
  if(valEl) valEl.textContent = parseFloat(val).toFixed(2);
  const slider = document.getElementById('nlp-' + {vote:'vote',fresh:'fresh',novel:'novel',diverse:'div'}[key]);
  if(slider) slider.style.setProperty('--pct', (parseFloat(val)*100).toFixed(1)+'%');
  const total = (nlpWeights.vote + nlpWeights.fresh + nlpWeights.novel + nlpWeights.diverse);
  const totalRow = document.querySelector('.nlp-total-row');
  if(totalRow) {
    const ok = Math.abs(total - 1.00) < 0.001;
    totalRow.className = 'nlp-total-row ' + (ok?'ok':'err');
    totalRow.innerHTML = `Total: ${total.toFixed(2)} <span class="${ok?'nlp-check':'nlp-warn'}">${ok?IC.check:'≠ 1.00'}</span>`;
  }
};

window.runNlpCompare = function() {
  // Simulate a random result between 60–95%
  nlpTest.result = Math.floor(Math.random() * 36) + 60;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderNLPEngine();
};

/* Moderation handlers */
window.setModTab = function(tab) {
  modTab = tab;
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderContentModeration();
};

window.setBanPopup = function(id) {
  modBanPopup = id === null ? null : parseInt(id);
  const content = document.getElementById('admin-content-area');
  if(content) content.innerHTML = renderContentModeration();
};

mount();

