  ]
};
let healthErrorFilter = 'errors'; // 'errors' | 'all'
let healthExpandedError = 3; // index of expanded error

function renderSystemHealth() {
  const rl = MOCK_HEALTH.rateLimited;
  const errs = MOCK_HEALTH.errors.filter(e => healthErrorFilter === 'all' || !e.msg.toLowerCase().includes('warn'));

  // Build polyline for ws chart
  const pts = MOCK_HEALTH.wsChartData;
  const W = 340, H = 120;
  const minV = Math.min(...pts) * 0.8;
  const maxV = Math.max(...pts) * 1.05;
  const toX = (i) => (i / (pts.length - 1)) * W;
  const toY = (v) => H - ((v - minV) / (maxV - minV)) * H;
  const polylinePoints = pts.map((v, i) => `${toX(i).toFixed(1)},${toY(v).toFixed(1)}`).join(' ');
  const areaPoints = `0,${H} ` + pts.map((v, i) => `${toX(i).toFixed(1)},${toY(v).toFixed(1)}`).join(' ') + ` ${W},${H}`;

  return `
    <div class="page active" id="page-health">
      <div class="page-header">
        <h1 class="page-title">System Health</h1>
        <p class="page-subtitle">Real-time system metrics, logs, and connection activity.</p>
      </div>
      <div class="health-three-col">

        <!-- Rate Limiting Card -->
        <div class="sys-card">
          <div class="sys-card-header">
            <div class="sys-card-title">${IC.shieldCheck} Rate Limiting</div>
            <div class="sys-card-sub">IPs that are currently rate-limited.</div>
            <button class="sys-icon-btn" style="margin-left:auto" title="Refresh">${IC.refresh}</button>
          </div>
          ${rl.length > 0 ? `
          <table class="sys-rl-table">
            <thead><tr>
              <th>IP Address</th><th>Request Count</th><th>Resets In</th><th></th>
            </tr></thead>
            <tbody>
              ${rl.map(r => `
              <tr>
                <td class="sys-rl-ip">${r.ip}</td>
                <td class="sys-rl-num">${r.requests.toLocaleString()}</td>
                <td class="sys-rl-timer">${r.resetsIn}</td>
                <td><button class="sys-unblock-btn">Unblock</button></td>
              </tr>`).join('')}
            </tbody>
          </table>
          ` : `
          <div class="sys-rl-empty">
            <div class="sys-rl-empty-icon">${IC.shieldCheck}</div>
            <div class="sys-rl-empty-title">No IPs are currently rate-limited</div>
            <div class="sys-rl-empty-sub">All clear! No IPs have exceeded the rate limit.</div>
          </div>`}
        </div>

        <!-- Error Log Card -->
        <div class="sys-card sys-card-dark">
          <div class="sys-card-header">
            <div class="sys-card-title sys-card-title-light">${IC.alertTriangle} Error Log</div>
            <div class="sys-card-sub sys-card-sub-light">Recent system errors and warnings.</div>
            <div class="sys-err-filter" style="margin-left:auto">
              <button class="sys-err-filter-btn ${healthErrorFilter==='errors'?'active':''}" onclick="setHealthFilter('errors')">Errors only</button>
              <button class="sys-err-filter-btn ${healthErrorFilter==='all'?'active':''}" onclick="setHealthFilter('all')">Warnings + Errors</button>
            </div>
          </div>
          <div class="sys-err-list">
            ${errs.map((e, idx) => `
            <div class="sys-err-item ${idx === healthExpandedError ? 'expanded' : ''}" onclick="toggleHealthError(${idx})">
              <div class="sys-err-row">
                <div class="sys-err-dot ${idx === healthExpandedError ? 'err-expanded-dot' : ''}"></div>
                <div class="sys-err-time">${e.time}</div>
                <div class="sys-err-msg">${e.msg}</div>
                <div class="sys-err-caret">${idx === healthExpandedError ? '∧' : '›'}</div>
              </div>
              ${idx === healthExpandedError ? `<pre class="sys-err-detail">${e.detail}</pre>` : ''}
            </div>`).join('')}
          </div>
          <div class="sys-card-footer-link" onclick="adminNavigate('audit')">View all errors ${IC.arrowRight}</div>
        </div>

        <!-- WebSocket Connections Card -->
        <div class="sys-card">
          <div class="sys-card-header">
            <div class="sys-card-title">${IC.wifi} WebSocket Connections</div>
            <div class="sys-card-sub" style="flex:1">Live WebSocket connections over the last hour.</div>
            <button class="sys-range-btn">Last 1 hour ${IC.chevronDown}</button>
          </div>
          <!-- SVG Chart -->
          <div class="sys-ws-chart-wrap">
            <svg viewBox="0 0 340 120" preserveAspectRatio="none" style="width:100%;height:100%;display:block">
              <defs>
                <linearGradient id="wsGrad" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#5b34ff" stop-opacity="0.18"/>
                  <stop offset="100%" stop-color="#5b34ff" stop-opacity="0.01"/>
                </linearGradient>
              </defs>
              <polygon points="${areaPoints}" fill="url(#wsGrad)"/>
              <polyline points="${polylinePoints}" fill="none" stroke="#5b34ff" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
            </svg>
            <!-- X-axis labels -->
            <div class="sys-ws-xaxis">
              <span>09:50</span><span>10:00</span><span>10:10</span><span>10:20</span><span>10:30</span><span>10:40</span><span>10:50</span>
            </div>
          </div>
          <!-- Stats row -->
          <div class="sys-ws-stats">
            <div class="sys-ws-main">
              <div class="sys-ws-stat-label">Current Connections</div>
              <div class="sys-ws-big">${MOCK_HEALTH.wsConnections.toLocaleString()}</div>
              <div class="sys-ws-delta"><span class="sys-ws-up">↑ ${MOCK_HEALTH.wsDelta}</span> vs 1 hour ago</div>
              <div style="margin-top:8px">
                <div class="sys-ws-stat-label">Across</div>
                <div class="sys-ws-meetings-num">${MOCK_HEALTH.wsActiveMeetings}</div>
                <div class="sys-ws-stat-label">active meetings</div>
              </div>
            </div>
            <div class="sys-ws-breakdown">
              ${MOCK_HEALTH.activeMeetings.map(m => `
              <div class="sys-ws-meeting-row">
                <span class="sys-ws-dot" style="background:${m.color}"></span>
                <span class="sys-ws-meeting-title">${m.title}</span>
                <span class="sys-ws-meeting-num">${m.connections}</span>
              </div>`).join('')}
            </div>
          </div>
          <div class="sys-card-footer-link" style="color:var(--primary)">View all active meetings ${IC.arrowRight}</div>
        </div>

      </div>
    </div>`;
}

