  errors: [
    { time:'12 May 2024, 10:48:21', msg:'Failed to process question embed…', expanded:false, detail:'Error: Embedding model returned null\n  at EmbeddingService.embed (services/embedding.ts:45:9)\n  at QuestionProcessor.process (services/question.ts:82:15)' },
    { time:'12 May 2024, 10:47:55', msg:'Database connection timeout',        expanded:false, detail:'Error: Connection pool exhausted after 5000ms\n  at Pool.acquire (lib/db/pool.ts:120:7)' },
    { time:'12 May 2024, 10:47:31', msg:'Redis connection lost',              expanded:false, detail:'Error: ECONNREFUSED 127.0.0.1:6379\n  at RedisClient.connect (lib/cache/redis.ts:33:5)' },
    { time:'12 May 2024, 10:46:08', msg:'WebSocket send failed: (…',         expanded:true,  detail:'WebSocketSendError: Connection closed\n  at WebSocket.send (ws/lib/websocket.js:458:17)\n  at MeetingService.broadcast (services/meeting.ts:218:15)\n  at processTicksAndRejections (internal/process/task_queues.js:95:5)\n  at async handleMessage (services/ws-handler.ts:132:9)\n  at async WebSocket.onMessage (services/ws-handler.ts:87:13)' },
