  { ts:'12 May 2024, 10:48:21.123', admin:'Arjun Dev',    adminRole:'superadmin', adminInit:'AD', action:'user.suspend',              actionType:'danger',  targetType:'User',         targetName:'Priya Sharma',          targetId:'userId: 8f2c9a1d', detail:{ userId:'8f2c9a1d', email:'priya.sharma@email.com', reason:'Violation of community guidelines', ipAddress:'103.21.45.67', userAgent:'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36' } },
