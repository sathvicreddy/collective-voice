/* ------------------------------------------------------------------
   NAV CONFIG
------------------------------------------------------------------ */
const NAV_ITEMS = [
  { id:'overview',   label:'Overview',          icon:IC.home     },
  { id:'live-now',   label:'Live Now',           icon:IC.radio    },
  { id:'users',      label:'Users',              icon:IC.users    },
  { id:'meetings',   label:'Meetings',           icon:IC.calendar },
  { id:'moderation', label:'Content Moderation', icon:IC.shield   },
  { id:'nlp',        label:'NLP Engine',         icon:IC.cpu      },
  { id:'health',     label:'System Health',      icon:IC.monitor  },
  { id:'audit',      label:'Audit Log',          icon:IC.fileText },
];

/* ------------------------------------------------------------------
   STATE
------------------------------------------------------------------ */
let currentPage         = 'overview';
let selectedMeetingId   = 1;
let selectedUserId      = 1;
let meetingDetailTab    = 'questions';
let meetingContextMenu  = null; // { meetingId, sub }
let showDeleteModal     = false;
let deleteMeetingId     = null;

/* ------------------------------------------------------------------
   HELPERS
------------------------------------------------------------------ */
function fmt(n) {
  if (n >= 1000) return (n/1000).toFixed(1).replace(/\.0$/,'')+'K';
  return String(n);
}
function initials(name) {
  return name.split(' ').map(w=>w[0]).join('').slice(0,2).toUpperCase();
}
function avatarStack(extra, colors=['#ede9ff','#e0eaff','#d6f5e8']) {
  let h = '<div class="participants-avatars">';
  for(let i=0;i<3;i++) h+=`<div class="pa-avatar" style="background:${colors[i%colors.length]}"></div>`;
  h+=`</div><span class="pa-more">+${extra}</span>`;
  return h;
}
function qBars(p,r,a){
  const t=Math.max(p+r+a,1);
  return `<div class="question-bars"><div class="q-bar pending" style="flex:${p/t}"></div><div class="q-bar review" style="flex:${r/t}"></div><div class="q-bar answered" style="flex:${a/t}"></div></div>`;
}
function qLegend(p,r,a){
  return `<div class="q-legend"><div class="q-legend-item"><div class="q-legend-dot" style="background:#ff8a2a"></div>${p} Pending</div><div class="q-legend-item"><div class="q-legend-dot" style="background:#5b34ff"></div>${r} Review</div><div class="q-legend-item"><div class="q-legend-dot" style="background:#24b86f"></div>${a} Answered</div></div>`;
}

function statusBadge(status) {
  const map = {
    live:      '<span class="status-badge-pill live">● LIVE</span>',
    upcoming:  '<span class="status-badge-pill upcoming">UPCOMING</span>',
    conducted: '<span class="status-badge-pill conducted">CONDUCTED</span>',
    past:      '<span class="status-badge-pill past">PAST</span>',
  };
  return map[status] || status;
}

function qStatusBadge(status) {
  const map = {
    pending:     '<span class="q-status-badge pending">PENDING</span>',
    under_review:'<span class="q-status-badge review">UNDER REVIEW</span>',
    answered:    '<span class="q-status-badge answered">ANSWERED</span>',
  };
  return map[status] || status;
}

function roleBadge(role) {
  const map = {
    superadmin: '<span class="role-badge superadmin">Superadmin</span>',
    admin:      '<span class="role-badge admin">Admin</span>',
    user:       '<span class="role-badge user">User</span>',
  };
  return map[role] || role;
}

function authMethod(auth) {
  if(auth==='google')   return `<span class="auth-method">${IC.google} Google</span>`;
  return `<span class="auth-method">${IC.lock} Password</span>`;
}

function colorForInit(init) {
  const colors = ['#ede9ff','#e0eaff','#d6f5e8','#fff3e0','#fde8e8','#e0f7fa'];
  let h = 0; for(const c of init) h += c.charCodeAt(0);
  return colors[h % colors.length];
}
function textColorForInit(init) {
  const colors = ['#5b34ff','#2966e8','#1a9c5a','#e07c00','#c0392b','#00838f'];
  let h = 0; for(const c of init) h += c.charCodeAt(0);
  return colors[h % colors.length];
}

/* ------------------------------------------------------------------
   SIDEBAR
------------------------------------------------------------------ */
function renderSidebar() {
  const navHtml = NAV_ITEMS.map(item => `
    <div class="nav-item ${item.id===currentPage?'active':''}" data-page="${item.id}" onclick="adminNavigate('${item.id}')">
      ${item.icon}<span>${item.label}</span>
    </div>`).join('');
  return `
    <aside class="admin-sidebar">
      <div class="sidebar-brand">
        <div class="sidebar-brand-icon">${IC.mic}</div>
        <div class="sidebar-brand-text">
          <div class="sidebar-brand-name">CollectiveVoice</div>
          <div class="sidebar-brand-sub">Admin Panel</div>
        </div>
      </div>
      <nav class="sidebar-nav">${navHtml}</nav>
      <div class="sidebar-status">
        <div class="status-badge-row"><div class="status-dot"></div><div class="status-label">System Status</div></div>
        <div class="status-sub">All Systems Operational</div>
        <div class="status-link" onclick="adminNavigate('health')">View System Health ${IC.arrowRight}</div>
      </div>
      <div class="sidebar-user">
        <div class="user-avatar">AD</div>
        <div class="user-info"><div class="user-name">Arjun Dev</div><div class="user-role">Superadmin</div></div>
        <span class="user-chevron">▲</span>
      </div>
    </aside>`;
}

/* ------------------------------------------------------------------
   TOPBAR
------------------------------------------------------------------ */
function renderTopbar() {
  return `
    <header class="admin-topbar">
      <div class="topbar-search">
        ${IC.search}
        <input type="text" placeholder="Search users, meetings, questions…" id="admin-search">
        <span class="search-kbd">⌘ K</span>
      </div>
      <div class="topbar-actions">
        <button class="topbar-notif-btn" title="Notifications">${IC.bell}<span class="notif-badge">5</span></button>
        <div class="topbar-user">
          <div class="topbar-avatar">AD</div>
          <div class="topbar-user-info"><div class="topbar-user-name">Arjun Dev</div><div class="topbar-user-role">Superadmin</div></div>
        </div>
        <button class="topbar-exit-btn" onclick="window.location.href='/'">Exit to regular app ${IC.logOut}</button>
      </div>
    </header>`;
}

/* ================================================================
   OVERVIEW PAGE
   ================================================================ */
function renderOverview() {
  const s = MOCK.stats, m = MOCK.liveMeetings.slice(0,3), h = MOCK.health;
  const chartMax = Math.max(...MOCK.chartData.map(d=>d.value));
  return `
    <div class="page active" id="page-overview">
      <div class="page-header page-header-row">
        <div><h1 class="page-title">Overview</h1><p class="page-subtitle">Platform at a glance. Real-time insights and key metrics.</p></div>
        <button class="date-filter-btn">${IC.calendar} Last 30 days ${IC.chevronDown}</button>
      </div>
      <div class="metrics-grid">
        <div class="metric-card" style="animation-delay:.0s"><div class="metric-icon blue">${IC.users}</div><div class="metric-body"><div class="metric-label">Total Users</div><div class="metric-value">${s.totalUsers.value.toLocaleString()}</div><div class="metric-sub"><span class="up">↑ ${s.totalUsers.delta}</span> ${s.totalUsers.sub}</div></div></div>
        <div class="metric-card" style="animation-delay:.06s"><div class="metric-icon green">${IC.calendar}</div><div class="metric-body"><div class="metric-label">Total Meetings</div><div class="metric-value">${s.totalMeetings.value}</div><div class="metric-pills"><span class="metric-pill live">${s.totalMeetings.live} live</span><span class="metric-pill upcoming">${s.totalMeetings.upcoming} upcoming</span><span class="metric-pill past">${s.totalMeetings.past} past</span></div></div></div>
        <div class="metric-card" style="animation-delay:.12s"><div class="metric-icon orange">${IC.messageCircle}</div><div class="metric-body"><div class="metric-label">Questions Asked<br><span style="font-size:10px;color:var(--muted)">(platform-wide)</span></div><div class="metric-value">${s.questions.value.toLocaleString()}</div><div class="metric-sub"><span class="up">↑ ${s.questions.delta}</span> ${s.questions.sub}</div></div></div>
        <div class="metric-card" style="animation-delay:.18s"><div class="metric-icon purple">${IC.thumbsUp}</div><div class="metric-body"><div class="metric-label">Votes Cast<br><span style="font-size:10px;color:var(--muted)">(platform-wide)</span></div><div class="metric-value">${s.votes.value.toLocaleString()}</div><div class="metric-sub"><span class="up">↑ ${s.votes.delta}</span> ${s.votes.sub}</div></div></div>
      </div>
      <div class="section-header">
        <div class="section-title"><div class="live-dot"></div>Live Right Now</div>
        <span class="live-count-chip">${MOCK.liveMeetings.length} meetings live</span>
        <div class="section-link" onclick="adminNavigate('live-now')">View all live meetings ${IC.arrowRight}</div>
      </div>
      <div class="live-cards-grid">
        ${m.map(meeting=>`
          <div class="live-card">
            <div><div class="live-badge"><span class="live-badge-dot"></span> LIVE</div><div class="live-card-title">${meeting.title}</div></div>
            <div class="live-card-host"><div class="host-avatar">${initials(meeting.host)}</div>${meeting.host}</div>
            <div class="live-card-stats">
              <div class="live-stat"><div class="live-stat-label">Participants</div><div style="display:flex;align-items:center;gap:6px;margin-top:2px">${avatarStack(meeting.extra)}</div></div>
              <div class="live-stat"><div class="live-stat-label">Questions</div><div class="live-stat-value">${meeting.questions}</div></div>
              <div class="live-stat"><div class="live-stat-label">Live for</div><div class="live-stat-value">${meeting.liveFor}</div></div>
            </div>
            <div class="live-card-footer"><button class="view-btn">View</button></div>
          </div>`).join('')}
      </div>
      <div class="bottom-grid">
        <div class="health-card">
          <div class="card-header"><div class="card-title">${IC.server} Server Health</div><div class="card-link" onclick="adminNavigate('health')">View full system health ${IC.arrowRight}</div></div>
          <div class="health-stats">
            <div><div class="health-stat-label">${IC.clock} Uptime</div><div class="health-stat-value">${h.uptime}</div><div class="health-stat-sub">${h.uptimeSub}</div></div>
            <div><div class="health-stat-label">${IC.memoryChip} Memory Usage</div><div class="health-stat-value">${h.memory}</div><div class="health-stat-sub">${h.memorySub}</div></div>
            <div><div class="health-stat-label">${IC.database} DB Status</div><div class="health-status-ok">${h.db}</div><div class="health-stat-sub">${h.dbSub}</div></div>
          </div>
        </div>
        <div class="chart-card">
          <div class="chart-header"><div class="card-title">${IC.barChart} Questions asked, last 7 days</div><button class="chart-range-btn">Last 7 days ${IC.chevronDown}</button></div>
          <div class="bar-chart-wrap">
            ${MOCK.chartData.map(d=>`
              <div class="bar-col">
                <div class="bar-value">${fmt(d.value)}</div>
                <div class="bar-bar-wrap"><div class="bar-bar" style="height:${Math.round((d.value/chartMax)*100)}%"></div></div>
                <div class="bar-label">${d.label}</div>
              </div>`).join('')}
          </div>
          <div style="margin-top:12px;text-align:right"><div class="card-link">View full analytics ${IC.arrowRight}</div></div>
        </div>
      </div>
    </div>`;
}

/* ================================================================
   LIVE NOW PAGE
   ================================================================ */
function renderLiveNow() {
  return `
    <div class="page active" id="page-live-now">
      <div class="page-header"><h1 class="page-title">Live Now</h1><p class="page-subtitle">Monitor all meetings that are currently live on the platform.</p></div>
      <div class="livenow-toolbar">
        <div class="view-toggle">
          <button class="view-toggle-btn active" id="card-view-btn" onclick="setLiveView('card')">${IC.grid} Card view</button>
          <button class="view-toggle-btn" id="table-view-btn" onclick="setLiveView('table')">${IC.table} Table view</button>
        </div>
        <div class="spacer"></div>
        <button class="refresh-btn" title="Refresh">${IC.refresh}</button>
        <div class="sort-select-wrap">Sort by: <select class="sort-select" onchange="sortLiveMeetings(this.value)"><option value="participants">Most participants</option><option value="questions">Most questions</option><option value="time">Longest live</option></select></div>
      </div>
      <div class="livenow-cards-grid" id="livenow-grid">
        ${MOCK.liveMeetings.map((m,i)=>`
          <div class="livenow-card" style="animation-delay:${i*.06}s">
            <div class="livenow-card-header"><div class="live-badge"><span class="live-badge-dot"></span> LIVE</div><button class="moderate-btn">View as Moderator</button></div>
            <div class="livenow-card-title">${m.title}</div>
            <div class="livenow-card-host"><div class="host-avatar">${initials(m.host)}</div>${m.host}</div>
            <div class="livenow-stats-row">
              <div><div class="livenow-stat-label">Participants</div><div style="display:flex;align-items:center;gap:4px;margin:4px 0 2px">${avatarStack(m.extra)}</div><div class="livenow-stat-value">${m.participants}</div></div>
              <div><div class="livenow-stat-label">Questions</div><div class="livenow-stat-value" style="margin-top:4px">${m.questions}</div></div>
              <div><div class="livenow-stat-label">Live for</div><div class="livenow-stat-small" style="margin-top:4px">${m.liveFor}</div></div>
            </div>
            ${qBars(m.pending,m.review,m.answered)}
            ${qLegend(m.pending,m.review,m.answered)}
          </div>`).join('')}
      </div>
      <div class="no-live-placeholder">
        <div class="no-live-icon">${IC.video}</div>
        <div class="no-live-title">No meetings are live right now</div>
        <div class="no-live-sub">When meetings go live, they will appear here in real-time.</div>
      </div>
    </div>`;
}

/* ================================================================
   MEETINGS PAGE
   ================================================================ */
function renderMeetings() {
  const meeting = MOCK.meetings.find(m=>m.id===selectedMeetingId) || MOCK.meetings[0];
  const hasPanel = !!meeting;

  const tableHtml = MOCK.meetings.map(m => `
    <tr class="dt-row ${m.id===selectedMeetingId?'dt-row-selected':''}" onclick="selectMeeting(${m.id})">
      <td class="dt-td"><span class="dt-meeting-title">${m.title}</span></td>
      <td class="dt-td">
        <div style="display:flex;align-items:center;gap:8px">
          <div class="tbl-avatar" style="background:${colorForInit(m.ownerInit)};color:${textColorForInit(m.ownerInit)}">${m.ownerInit}</div>
          <span class="dt-owner">${m.owner}</span>
        </div>
      </td>
      <td class="dt-td">${statusBadge(m.status)}</td>
      <td class="dt-td"><span class="dt-code">${m.code}</span></td>
      <td class="dt-td">${m.questions}</td>
      <td class="dt-td">${m.status==='live'||m.status==='upcoming'?m.participants:'—'}</td>
      <td class="dt-td dt-muted">${m.created}</td>
      <td class="dt-td dt-actions">
        <div class="dt-actions-wrap">
          <button class="dt-more-btn" onclick="toggleMeetingMenu(event,${m.id})">${IC.moreHoriz}</button>
          ${meetingContextMenu?.meetingId===m.id ? renderMeetingContextMenu(m.id) : ''}
        </div>
      </td>
    </tr>`).join('');

  const detailHtml = hasPanel ? renderMeetingDetailPanel(meeting) : '';

  const deleteModal = showDeleteModal ? renderDeleteModal() : '';

  return `
    <div class="page active" id="page-meetings">
      ${deleteModal}
      <div class="page-header page-header-row">
        <div><h1 class="page-title">Meetings <span class="page-count">154 meetings</span></h1></div>
      </div>
      <div class="dt-filters">
        <div class="dt-search-wrap">${IC.search}<input class="dt-search-input" placeholder="Search by title or code…" type="text"></div>
        <div class="filter-group">
          <label class="filter-label">Status</label>
          <div class="filter-select-wrap">
            <select class="filter-select"><option>All</option><option>Live</option><option>Upcoming</option><option>Conducted</option><option>Past</option></select>
            ${IC.chevronDown}
          </div>
        </div>
        <div class="filter-group">
          <label class="filter-label">Owner</label>
          <div class="filter-select-wrap">
            <select class="filter-select"><option>All owners</option></select>
            ${IC.chevronDown}
          </div>
        </div>
        <button class="clear-filters-btn">Clear filters</button>
      </div>

      <div class="dt-layout">
        <!-- Table -->
        <div class="dt-table-wrap">
          <table class="dt-table">
            <thead><tr>
              <th class="dt-th">TITLE</th><th class="dt-th">OWNER</th><th class="dt-th">STATUS</th>
              <th class="dt-th">CODE</th><th class="dt-th">QUESTIONS</th><th class="dt-th">PARTICIPANTS</th>
              <th class="dt-th">CREATED</th><th class="dt-th"></th>
            </tr></thead>
            <tbody>${tableHtml}</tbody>
          </table>
          <div class="dt-footer">
            <div class="dt-showing">Showing 1 to 10 of 154 meetings</div>
            <div class="pagination">
              <button class="pg-btn">${IC.chevronLeft}</button>
              <button class="pg-btn active">1</button>
              <button class="pg-btn">2</button><button class="pg-btn">3</button>
              <button class="pg-btn">4</button><button class="pg-btn">5</button>
              <span class="pg-ellipsis">…</span>
              <button class="pg-btn">16</button>
              <button class="pg-btn">${IC.chevronRight}</button>
            </div>
          </div>
        </div>
        <!-- Detail panel -->
        ${hasPanel ? `<div class="detail-panel" id="detail-panel">${detailHtml}</div>` : ''}
      </div>
    </div>`;
}

function renderMeetingContextMenu(meetingId) {
  const sub = meetingContextMenu?.sub;
  return `
    <div class="context-menu" onclick="event.stopPropagation()">
      <div class="ctx-item" onclick="showStatusSubmenu(${meetingId})">
        ${IC.zap} Force Status Change <span class="ctx-arrow">›</span>
        ${sub==='status'?`
          <div class="ctx-submenu">
            <div class="ctx-sub-item live">● Live</div>
            <div class="ctx-sub-item upcoming">● Upcoming</div>
            <div class="ctx-sub-item conducted">● Conducted</div>
            <div class="ctx-sub-item past">● Past</div>
          </div>`:''}</div>
      <div class="ctx-item">${IC.monitor} View as Moderator</div>
      <div class="ctx-item">${IC.userCheck} Reassign Owner</div>
      <div class="ctx-sep"></div>
      <div class="ctx-item danger" onclick="openDeleteModal(${meetingId})">${IC.trash} Delete Meeting</div>
    </div>`;
}

function renderMeetingDetailPanel(meeting) {
  const tab = meetingDetailTab;
  return `
    <div class="dp-header">
      <div class="dp-title-row">
        <h3 class="dp-title">${meeting.title}</h3>
        ${meeting.status==='live'?'<span class="dp-live-badge">● LIVE</span>':''}
        <button class="dp-close-btn" onclick="closeMeetingPanel()">${IC.x}</button>
      </div>
      <div class="dp-meta-row">
        <span class="dp-id">${meeting.code}</span>
        <span class="dp-copy-btn">⧉</span>
      </div>
      <div class="dp-host-row">
        <div class="tbl-avatar sm" style="background:${colorForInit(meeting.ownerInit)};color:${textColorForInit(meeting.ownerInit)}">${meeting.ownerInit}</div>
        <span class="dp-host">${meeting.owner}</span>
        <span class="dp-created">· Created on ${meeting.created}, 09:30 AM</span>
      </div>
      ${meeting.desc?`<p class="dp-desc">${meeting.desc}</p>`:''}
    </div>

    <div class="dp-settings-grid">
      <div class="dp-setting-item"><span>Allow Questions</span><span class="dp-setting-icon ${meeting.settings.allowQ?'ok':'no'}">${meeting.settings.allowQ?IC.check:IC.x}</span></div>
      <div class="dp-setting-item"><span>Allow Upvotes</span><span class="dp-setting-icon ${meeting.settings.upvotes?'ok':'no'}">${meeting.settings.upvotes?IC.check:IC.x}</span></div>
      <div class="dp-setting-item"><span>Enable Chat</span><span class="dp-setting-icon ${meeting.settings.chat?'ok':'no'}">${meeting.settings.chat?IC.check:IC.x}</span></div>
      <div class="dp-setting-item"><span>Question Clustering</span><span class="dp-setting-icon ${meeting.settings.clustering?'ok':'no'}">${meeting.settings.clustering?IC.check:IC.x}</span></div>
      <div class="dp-setting-item"><span>Record Meeting</span><span class="dp-setting-icon ${meeting.settings.record?'ok':'no'}">${meeting.settings.record?IC.check:IC.x}</span></div>
      <div class="dp-setting-item"><span>Allow Reactions</span><span class="dp-setting-icon ${meeting.settings.reactions?'ok':'no'}">${meeting.settings.reactions?IC.check:IC.x}</span></div>
    </div>

    <div class="dp-tabs">
      <button class="dp-tab ${tab==='questions'?'active':''}" onclick="setMeetingTab('questions')">Questions</button>
      <button class="dp-tab ${tab==='polls'?'active':''}" onclick="setMeetingTab('polls')">Polls</button>
      <button class="dp-tab ${tab==='participants'?'active':''}" onclick="setMeetingTab('participants')">Participants</button>
    </div>

    ${tab==='questions' ? renderDPQuestions(meeting) : ''}
    ${tab==='polls'     ? renderDPPolls(meeting)     : ''}
    ${tab==='participants'?renderDPParticipants(meeting):''}

    <div class="dp-footer">
      <div class="dp-status-wrap">
        <div class="live-dot" style="flex-shrink:0"></div>
        <select class="dp-status-select"><option>Live</option><option>Upcoming</option><option>Conducted</option><option>Past</option></select>
      </div>
      <button class="moderate-btn">View as Moderator</button>
      <button class="danger-btn" onclick="openDeleteModal(${meeting.id})">${IC.trash} Delete Meeting</button>
    </div>`;
}

function renderDPQuestions(meeting) {
  const qs = meeting.questions_data;
  if(!qs.length) return '<div class="dp-empty">No questions yet.</div>';
  return `
    <div class="dp-section">
      <table class="dp-table">
        <thead><tr><th>QUESTION</th><th>STATUS</th><th>VOTES</th><th>SIMILAR COUNT</th></tr></thead>
        <tbody>
          ${qs.map(q=>`<tr>
            <td class="dp-q-text">${q.text}</td>
            <td>${qStatusBadge(q.status)}</td>
            <td class="dp-num">${q.votes}</td>
            <td class="dp-num">${q.similar}</td>
          </tr>`).join('')}
        </tbody>
      </table>
      <div class="dp-view-all">View all ${meeting.questions} questions ${IC.arrowRight}</div>
    </div>`;
}

function renderDPPolls(meeting) {
  const polls = meeting.polls;
  if(!polls.length) return '<div class="dp-empty">No polls yet.</div>';
  return `
    <div class="dp-section">
      <div class="dp-polls-grid">
        ${polls.map(poll=>`
          <div class="dp-poll-card">
            <div class="dp-poll-header">
              <span class="dp-poll-q">${poll.q}</span>
              <span class="poll-status-badge ${poll.status}">${poll.status.toUpperCase()}</span>
            </div>
            ${poll.options.map(o=>`
              <div class="dp-poll-option">
                <div class="dp-poll-label-row"><span>${o.l}</span><span class="dp-poll-pct">${o.pct}% (${o.n})</span></div>
                <div class="dp-poll-bar-wrap"><div class="dp-poll-bar" style="width:${o.pct}%"></div></div>
              </div>`).join('')}
          </div>`).join('')}
      </div>
      <div class="dp-view-all">View all ${meeting.polls.length} polls ${IC.arrowRight}</div>
    </div>`;
}

function renderDPParticipants(meeting) {
  return `<div class="dp-empty">Participant management coming soon.</div>`;
}

function renderDeleteModal() {
  const meeting = MOCK.meetings.find(m=>m.id===deleteMeetingId);
  if(!meeting) return '';
  return `
    <div class="modal-overlay" onclick="closeDeleteModal()">
      <div class="modal" onclick="event.stopPropagation()">
        <div class="modal-icon">${IC.alertCircle}</div>
        <h3 class="modal-title">Delete '${meeting.title}'?</h3>
        <p class="modal-body">This will also delete <b>${meeting.questions} questions</b>, <b>${meeting.polls.length} polls</b>, and <b>12 participant records</b>.</p>
        <div class="modal-actions">
          <button class="modal-cancel" onclick="closeDeleteModal()">Cancel</button>
          <button class="modal-delete">Delete Meeting</button>
        </div>
      </div>
    </div>`;
}

/* ================================================================
   USERS PAGE
   ================================================================ */
function renderUsers() {
  const user = MOCK.users.find(u=>u.id===selectedUserId) || MOCK.users[0];
  const hasPanel = !!user;

  const tableHtml = MOCK.users.map(u=>`
    <tr class="dt-row ${u.id===selectedUserId?'dt-row-selected':''}" onclick="selectUser(${u.id})">
      <td class="dt-td">
        <div style="display:flex;align-items:center;gap:10px">
          <div class="tbl-avatar" style="background:${colorForInit(u.init)};color:${textColorForInit(u.init)}">${u.init}</div>
          <div><div class="dt-user-name">${u.name}</div><div class="dt-user-email">${u.email}</div></div>
        </div>
      </td>
      <td class="dt-td">${roleBadge(u.role)}</td>
      <td class="dt-td">${authMethod(u.auth)}</td>
      <td class="dt-td">${u.meetings}</td>
      <td class="dt-td">${u.questions}</td>
      <td class="dt-td dt-muted">${u.joined}</td>
      <td class="dt-td dt-muted">${u.lastActive}</td>
      <td class="dt-td dt-actions"><div class="dt-actions-wrap"><button class="dt-more-btn">${IC.moreHoriz}</button></div></td>
    </tr>`).join('');

  const detailHtml = hasPanel ? renderUserDetailPanel(user) : '';

  return `
    <div class="page active" id="page-users">
      <div class="page-header page-header-row">
        <div><h1 class="page-title">Users <span class="page-count">1,204 users</span></h1></div>
      </div>
      <div class="dt-filters">
        <div class="dt-search-wrap">${IC.search}<input class="dt-search-input" placeholder="Search by name or email…" type="text"></div>
        <div class="filter-group">
          <label class="filter-label">Role</label>
          <div class="filter-select-wrap">
            <select class="filter-select"><option>All</option><option>Superadmin</option><option>Admin</option><option>User</option></select>
            ${IC.chevronDown}
          </div>
        </div>
        <div class="filter-group">
          <label class="filter-label">Auth method</label>
          <div class="filter-select-wrap">
            <select class="filter-select"><option>All</option><option>Google</option><option>Password</option></select>
            ${IC.chevronDown}
          </div>
        </div>
        <div class="filter-group">
          <label class="filter-label">Joined between</label>
          <div class="filter-select-wrap"><input type="text" class="filter-date-input" placeholder="Pick dates…"> ${IC.calendar}</div>
        </div>
        <button class="clear-filters-btn">Clear filters</button>
      </div>

      <div class="dt-layout">
        <div class="dt-table-wrap">
          <table class="dt-table">
            <thead><tr>
              <th class="dt-th">USER</th><th class="dt-th">ROLE</th><th class="dt-th">AUTH METHOD</th>
              <th class="dt-th">MEETINGS OWNED</th><th class="dt-th">QUESTIONS ASKED</th>
              <th class="dt-th">JOINED DATE</th><th class="dt-th">LAST ACTIVE</th><th class="dt-th"></th>
            </tr></thead>
            <tbody>${tableHtml}</tbody>
          </table>
          <div class="dt-footer">
            <div class="dt-showing">Showing 1 to 10 of 1,204 users</div>
            <div class="pagination-row">
              <div class="pagination">
                <button class="pg-btn">${IC.chevronLeft}</button>
                <button class="pg-btn active">1</button>
                <button class="pg-btn">2</button><button class="pg-btn">3</button><button class="pg-btn">4</button><button class="pg-btn">5</button>
                <span class="pg-ellipsis">…</span><button class="pg-btn">121</button>
                <button class="pg-btn">${IC.chevronRight}</button>
              </div>
              <div class="per-page-wrap">
                <select class="filter-select">
                  <option>25 per page</option><option>50 per page</option><option>100 per page</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        ${hasPanel?`<div class="detail-panel user-detail-panel" id="user-detail-panel">${detailHtml}</div>`:''}
      </div>
    </div>`;
}

function renderUserDetailPanel(user) {
  return `
    <div class="dp-header">
      <div class="dp-title-row">
        <div></div>
        <button class="dp-close-btn" onclick="closeUserPanel()">${IC.x}</button>
      </div>
      <div class="udp-profile">
        <div class="udp-avatar" style="background:${colorForInit(user.init)};color:${textColorForInit(user.init)}">${user.init}</div>
        <div>
          <div class="udp-name-row">
            <span class="udp-name">${user.name}</span>
            ${roleBadge(user.role)}
          </div>
          <div class="udp-email">${user.email}</div>
          <div class="udp-meta">${authMethod(user.auth)} · Joined on ${user.joined}</div>
        </div>
      </div>
    </div>

    ${user.suspended?`
      <div class="udp-suspended-banner">
        <span class="udp-suspended-icon">${IC.alertCircle}</span>
        <span>This account is suspended</span>
        <button class="udp-reactivate-btn">Reactivate</button>
      </div>`:``}

    <div class="dp-section-scroll">
      <!-- Owned Meetings -->
      <div class="udp-section">
        <div class="udp-section-header"><span>Owned Meetings (${user.ownedMeetings.length || 24})</span><span class="udp-view-all">View all</span></div>
        ${(user.ownedMeetings.length?user.ownedMeetings:MOCK.meetings.slice(0,3).map(m=>({title:m.title,status:m.status,q:m.questions}))).map(m=>`
          <div class="udp-meeting-row">
            <span class="udp-meeting-title">${m.title}</span>
            ${statusBadge(m.status)}
            <span class="udp-meeting-q">${m.q} questions</span>
            <span class="udp-caret">›</span>
          </div>`).join('')}
        <div class="udp-show-more">…</div>
      </div>

      <!-- Recent Questions -->
      <div class="udp-section">
        <div class="udp-section-header"><span>Recent Questions (${user.recentQ.length || 20})</span><span class="udp-view-all">View all</span></div>
        ${(user.recentQ.length?user.recentQ:[
          {text:'How can AI personalize learning experiences…',status:'pending',    meeting:'AI in Education Summit',  ago:'2m ago' },
          {text:'What are the key ethical concerns in AI?',   status:'under_review',meeting:'Future of Work Webinar', ago:'18m ago'},
          {text:'Best practices for implementing AI in classrooms?',status:'answered',meeting:'AI in Education Summit',ago:'1h ago'},
        ]).map(q=>`
          <div class="udp-q-row">
            <div class="udp-q-text">${q.text}</div>
            <div class="udp-q-meta">${q.meeting} ${qStatusBadge(q.status)} <span class="udp-ago">${q.ago}</span></div>
          </div>`).join('')}
        <div class="udp-show-more">…</div>
      </div>

      <!-- Recent Votes -->
      <div class="udp-section">
        <div class="udp-section-header"><span>Recent Votes (20)</span><span class="udp-view-all">View all</span></div>
        ${[
          {text:'How can AI personalize learning expe…', meeting:'AI in Education Summit',   ago:'2m ago' },
          {text:'What are the key ethical concerns in AI?',meeting:'Future of Work Webinar', ago:'18m ago'},
        ].map(v=>`
          <div class="udp-vote-row">
            <div class="udp-vote-text">Voted on: ${v.text}</div>
            <div class="udp-vote-meta">${v.meeting} <span class="udp-ago">${v.ago}</span></div>
          </div>`).join('')}
        <div class="udp-show-more">…</div>
      </div>

      <!-- Notifications -->
      <div class="udp-section">
        <div class="udp-section-header"><span>Notifications (10)</span><span class="udp-view-all">View all</span></div>
        ${(user.notifications.length?user.notifications:[
          {type:'system',  text:'Password changed successfully',      ago:'2d ago'},
          {type:'security',text:'New login from Chrome on Windows',   ago:'3d ago'},
          {type:'meeting', text:'You were added as admin to a meeting',ago:'5d ago'},
        ]).map(n=>`
          <div class="udp-notif-row">
            <span class="udp-notif-type ${n.type}">${n.type.toUpperCase()}</span>
            <span class="udp-notif-text">${n.text}</span>
            <span class="udp-ago">${n.ago}</span>
          </div>`).join('')}
        <div class="udp-show-more">…</div>
      </div>
    </div>

    <div class="udp-footer">
      <button class="udp-btn reactivate">Reactivate</button>
      <button class="udp-btn reset">Reset Password</button>
      <button class="udp-btn role">Change Role ${IC.chevronDown}</button>
      <button class="udp-btn danger">${IC.trash} Delete Account</button>
    </div>`;
}

/* ================================================================
   PLACEHOLDER PAGES
   ================================================================ */
function renderPlaceholder(label, icon) {
  return `
    <div class="page active">
      <div class="page-header"><h1 class="page-title">${label}</h1><p class="page-subtitle">Manage your platform ${label.toLowerCase()} from here.</p></div>
      <div class="coming-soon-wrap">${icon}<div class="coming-soon-title">${label} — Coming Soon</div><p style="font-size:13.5px;color:var(--muted)">This section is under development.</p></div>
    </div>`;
}

/* ================================================================
   ROUTING
   ================================================================ */
/* ================================================================
   CONTENT MODERATION PAGE
   ================================================================ */
const MOCK_MOD = {
  activeTab: 'flagged',
  items: [
    { id:1, meeting:'AI in Education Summit',   time:'12 May 2024, 10:48 AM', text:'Will AI replace teachers in the next 5 years?',                    asker:'Rahul Verma',  similar:23, reason:'Potentially off-topic and incites fear / negative sentiment', status:'flagged',         banPopup:false },
    { id:2, meeting:'Future of Work Webinar',   time:'12 May 2024, 10:32 AM', text:'This speaker is clueless and has no real-world experience.',       asker:'Meera Nair',   similar:7,  reason:'Personal attack / abusive language.',                       status:'pending_review',  banPopup:false },
    { id:3, meeting:'Startup Pitch Session',    time:'12 May 2024, 10:15 AM', text:'Can I get the founder\'s phone number?',                           asker:'Vikram Patel', similar:4,  reason:'Requests for personal information.',                        status:'flagged',         banPopup:false },
    { id:4, meeting:'Marketing Masters Live',   time:'12 May 2024, 09:58 AM', text:'Spam link: visit my site for free followers',                      asker:'Unknown User', similar:1,  reason:'Spam / self-promotion.',                                    status:'resolved',        banPopup:false },
    { id:5, meeting:'Research Roundtable',      time:'12 May 2024, 09:41 AM', text:'Are there any grants available for this research?',                 asker:'Ananya Iyer',  similar:3,  reason:'Off-topic for this session.',                               status:'flagged',         banPopup:true  },
  ]
};
let modTab = 'flagged';
let modBanPopup = null; // item id

function modStatusBadge(status) {
  const map = {
    flagged:        '<span class="mod-badge flagged">FLAGGED</span>',
    pending_review: '<span class="mod-badge pending">PENDING REVIEW</span>',
    resolved:       '<span class="mod-badge resolved">RESOLVED</span>',
  };
  return map[status] || '';
}

function renderContentModeration() {
  const tabs = [
    { id:'flagged',   label:'Flagged',      count:24  },
    { id:'all',       label:'All Statuses', count:215 },
    { id:'answered',  label:'Answered',     count:143 },
  ];
  const tabsHtml = tabs.map(t => `
    <button class="mod-tab ${modTab===t.id?'active':''}" onclick="setModTab('${t.id}')">
      ${t.label} <span class="mod-tab-count">${t.count}</span>
    </button>`).join('');

  const itemsHtml = MOCK_MOD.items.map(item => {
    const banHtml = (modBanPopup === item.id) ? `
      <div class="ban-popup">
        <div class="ban-popup-title">Ban submitter?</div>
        <div class="ban-popup-body">This will prevent this user from asking questions across all meetings.</div>
        <div class="ban-popup-actions">
          <button class="ban-cancel-btn" onclick="setBanPopup(null)">Cancel</button>
          <button class="ban-confirm-btn">Ban User</button>
        </div>
      </div>` : '';
    return `
      <div class="mod-item">
        <div class="mod-item-header">
          <div class="mod-item-meta">
            <span class="mod-meeting-link">${item.meeting} ${IC.externalLink}</span>
            <span class="mod-dot">·</span>
            <span class="mod-time">${item.time}</span>
          </div>
          ${modStatusBadge(item.status)}
        </div>
        <div class="mod-question-text">${item.text}</div>
        <div class="mod-asker-row">
          Asked by <span class="mod-asker-name">${item.asker}</span>
          <span class="mod-dot">·</span>
          represents ${item.similar} similar question${item.similar!==1?'s':''}
        </div>
        <div class="mod-reason-row">
          ${IC.flag} Flagged reason: ${item.reason}
        </div>
        <div class="mod-actions-row">
          <button class="mod-action-btn dismiss">Dismiss Flag</button>
          <button class="mod-action-btn delete">Delete Question</button>
          <div class="mod-ban-wrap" style="position:relative">
            <button class="mod-action-btn ban" onclick="setBanPopup(${modBanPopup===item.id?'null':item.id});event.stopPropagation()">${IC.userMinus} Ban Submitter</button>
            ${banHtml}
          </div>
        </div>
      </div>`;
  }).join('');

  const emptyHtml = `
    <div class="mod-empty">
      <div class="mod-empty-icon">
        <svg viewBox="0 0 80 60" fill="none" xmlns="http://www.w3.org/2000/svg" width="90" height="68">
          <rect x="8" y="12" width="44" height="36" rx="4" fill="#ede9ff" stroke="#5b34ff" stroke-width="1.5"/>
          <rect x="18" y="4" width="44" height="36" rx="4" fill="#e0eaff" stroke="#2966e8" stroke-width="1.5"/>
          <circle cx="62" cy="44" r="14" fill="#d6f5e8" stroke="#24b86f" stroke-width="1.5"/>
          <polyline points="56,44 60,48 68,40" stroke="#24b86f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <div class="mod-empty-title">No flagged content right now</div>
      <div class="mod-empty-sub">Great job! There are no flagged questions to review.</div>
    </div>`;

  return `
    <div class="page active" id="page-moderation">
      <div class="page-header page-header-row">
        <div><h1 class="page-title">Content Moderation</h1></div>
        <button class="refresh-btn">${IC.refresh} Refresh</button>
      </div>
      <div class="mod-tabs">${tabsHtml}</div>
      <div class="mod-list">
        ${itemsHtml}
        ${emptyHtml}
      </div>
    </div>`;
}

/* ================================================================
   NLP ENGINE PAGE
   ================================================================ */
let nlpThreshold = 0.60;
let nlpWeights = { vote:0.40, fresh:0.25, novel:0.20, diverse:0.15 };
let nlpTest = { a:'How will AI impact the future of education?', b:'What is the future of AI in education?', result:87 };
let nlpRate = { maxReq:1200, window:60 };

function renderSlider(id, label, greek, min, max, step, val, onInput, color='var(--primary)') {
  return `
    <div class="nlp-slider-row">
      <div class="nlp-slider-label">${label}${greek?` <span class="nlp-greek">(${greek})</span>`:''}</div>
      <div class="nlp-slider-track-wrap">
        <span class="nlp-range-val">${min.toFixed(2)}</span>
        <div class="nlp-slider-wrap">
          <input type="range" id="${id}" class="nlp-slider" min="${min}" max="${max}" step="${step}" value="${val}"
            style="--pct:${((val-min)/(max-min)*100).toFixed(1)}%"
            oninput="${onInput}">
        </div>
        <span class="nlp-range-val">${max.toFixed(2)}</span>
      </div>
      <div class="nlp-slider-val" id="${id}-val">${val.toFixed(2)}</div>
    </div>`;
}

function renderNLPEngine() {
  const total = (nlpWeights.vote + nlpWeights.fresh + nlpWeights.novel + nlpWeights.diverse).toFixed(2);
  const totalOk = Math.abs(parseFloat(total) - 1.00) < 0.001;

  return `
    <div class="page active" id="page-nlp">
      <div class="page-header page-header-row" style="margin-bottom:20px">
        <div>
          <h1 class="page-title">NLP Engine</h1>
          <p class="page-subtitle">Configure semantic clustering and ranking engine.</p>
        </div>
        <span class="nlp-status-badge">${IC.zap} Semantic Embeddings Active</span>
      </div>

      <!-- Section 1: Clustering Threshold -->
      <div class="nlp-section">
        <div class="nlp-section-header"><span class="nlp-section-num">1</span> Clustering Threshold</div>
        <div class="nlp-section-body">
          <div class="nlp-threshold-row">
            <div class="nlp-threshold-left">
              <div class="nlp-slider-label" style="margin-bottom:12px">Similarity Threshold</div>
              <div class="nlp-slider-track-wrap">
                <span class="nlp-range-val">0.00</span>
                <div class="nlp-slider-wrap">
                  <input type="range" id="nlp-threshold" class="nlp-slider" min="0" max="1" step="0.01" value="${nlpThreshold}"
                    style="--pct:${(nlpThreshold*100).toFixed(1)}%"
                    oninput="updateNlpThreshold(this.value)">
                </div>
                <span class="nlp-range-val">1.00</span>
              </div>
              <p class="nlp-hint">Questions scoring above this are merged into the same cluster.</p>
            </div>
            <div class="nlp-threshold-display">${nlpThreshold.toFixed(2)}</div>
          </div>
          <div class="nlp-section-footer">
            <button class="nlp-reset-btn">Reset to default</button>
            <button class="nlp-save-btn">Save</button>
          </div>
        </div>
      </div>

      <!-- Section 2: Scoring Weights -->
      <div class="nlp-section">
        <div class="nlp-section-header"><span class="nlp-section-num">2</span> Scoring Weights</div>
        <div class="nlp-section-body">
          ${renderSlider('nlp-vote',  'Vote Weight',      'α', 0, 1, 0.01, nlpWeights.vote,    'updateNlpWeight("vote",this.value)'   )}
          ${renderSlider('nlp-fresh', 'Freshness Weight', 'β', 0, 1, 0.01, nlpWeights.fresh,   'updateNlpWeight("fresh",this.value)'  )}
          ${renderSlider('nlp-novel', 'Novelty Weight',   'γ', 0, 1, 0.01, nlpWeights.novel,   'updateNlpWeight("novel",this.value)'  )}
          ${renderSlider('nlp-div',   'Diversity Weight', 'δ', 0, 1, 0.01, nlpWeights.diverse, 'updateNlpWeight("diverse",this.value)')}
          <div class="nlp-total-row ${totalOk?'ok':'err'}">
            Total: ${total} ${totalOk ? `<span class="nlp-check">${IC.check}</span>` : '<span class="nlp-warn">≠ 1.00</span>'}
          </div>
          <div class="nlp-section-footer" style="border-top:0;padding-top:0">
            <span></span>
            <button class="nlp-save-btn">Save</button>
          </div>
        </div>
      </div>

      <!-- Section 3: Test Cluster Tool -->
      <div class="nlp-section">
        <div class="nlp-section-header">
          <span class="nlp-section-num">3</span> Test Cluster Tool
          <span class="nlp-try-badge">${IC.zap} Try it out</span>
        </div>
        <div class="nlp-section-body">
          <div class="nlp-test-row">
            <div class="nlp-test-input-wrap">
              <label class="nlp-test-label">Question A</label>
              <textarea class="nlp-test-area" id="nlp-qa" rows="3" placeholder="Enter first question…">${nlpTest.a}</textarea>
            </div>
            <div class="nlp-swap-btn">${IC.arrowSwap}</div>
            <div class="nlp-test-input-wrap">
              <label class="nlp-test-label">Question B</label>
              <textarea class="nlp-test-area" id="nlp-qb" rows="3" placeholder="Enter second question…">${nlpTest.b}</textarea>
            </div>
          </div>
          <div style="text-align:center;margin:14px 0 18px">
            <button class="nlp-compare-btn" onclick="runNlpCompare()">${IC.zap} Compare</button>
          </div>
          ${nlpTest.result !== null ? `
          <div class="nlp-result-card">
            <div class="nlp-result-circle-wrap">
              <svg width="80" height="80" viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="34" fill="none" stroke="#e6f9f1" stroke-width="8"/>
                <circle cx="40" cy="40" r="34" fill="none" stroke="#24b86f" stroke-width="8"
                  stroke-dasharray="${(2*Math.PI*34*nlpTest.result/100).toFixed(1)} ${(2*Math.PI*34).toFixed(1)}"
                  stroke-dashoffset="${(2*Math.PI*34*0.25).toFixed(1)}"
                  stroke-linecap="round" transform="rotate(-90 40 40)"/>
                <text x="40" y="45" text-anchor="middle" font-size="16" font-weight="800" fill="#111936">${nlpTest.result}%</text>
              </svg>
            </div>
            <div class="nlp-result-text-wrap">
              <div class="nlp-result-title">${nlpTest.result}% similar — would merge</div>
              <div class="nlp-result-sub">These questions are semantically very similar and will be clustered together.</div>
            </div>
          </div>` : ''}
        </div>
      </div>

      <!-- Section 4: Rate Limiting -->
      <div class="nlp-section">
        <div class="nlp-section-header"><span class="nlp-section-num">4</span> Rate Limiting</div>
        <div class="nlp-section-body">
          <div class="nlp-rate-row">
            <div class="nlp-rate-field">
              <label class="nlp-rate-label">Max Requests</label>
              <div class="nlp-number-wrap">
                <input type="number" class="nlp-number-input" value="${nlpRate.maxReq}" id="nlp-maxreq">
                <div class="nlp-number-btns">
                  <button onclick="document.getElementById('nlp-maxreq').stepUp()">▲</button>
                  <button onclick="document.getElementById('nlp-maxreq').stepDown()">▼</button>
                </div>
              </div>
              <div class="nlp-rate-hint">Maximum requests allowed</div>
            </div>
            <div class="nlp-rate-field">
              <label class="nlp-rate-label">Window (minutes)</label>
              <div class="nlp-number-wrap">
                <input type="number" class="nlp-number-input" value="${nlpRate.window}" id="nlp-window">
                <div class="nlp-number-btns">
                  <button onclick="document.getElementById('nlp-window').stepUp()">▲</button>
                  <button onclick="document.getElementById('nlp-window').stepDown()">▼</button>
                </div>
              </div>
              <div class="nlp-rate-hint">Time window for the limit</div>
            </div>
            <button class="nlp-save-btn" style="align-self:center;margin-top:16px">Save</button>
          </div>
        </div>
      </div>

    </div>`;
}

