// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  // PostgreSQL for production (Neon). For local dev swap back to sqlite + file:./dev.db
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Users ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?  // null for Google-only accounts
  googleId     String?  @unique
  picture      String?  // Google profile photo URL
  role         String   @default("customer") // "superadmin" | "admin" | "customer"
  createdAt    DateTime @default(now())

  // Relations
  meetings         Meeting[]
  questions        Question[]        @relation("QuestionAskedBy")
  participants     Participant[]
  notifications    Notification[]
  resetTokens      ResetToken[]
  refreshTokens    RefreshToken[]
  enrollments      MeetingEnrollment[]
  meetingTemplates MeetingTemplate[]
  messagesSent     AdminMessage[]    @relation("MessagesSent")
  preferences      NotificationPreference?
}

// ── Meetings ──────────────────────────────────────────────────────────────────

model Meeting {
  id          String   @id @default(cuid())
  code        String   @unique // 6-digit join code
  title       String
  speaker     String
  status      String   @default("upcoming") // upcoming | live | conducted | past | expired
  date        String   @default("")
  time        String   @default("")
  duration    String   @default("")
  scheduledAt DateTime? // ISO timestamp for sorting / display
  graceEndsAt DateTime? // set when a grace period is active for this meeting
  description String   @default("")
  category    String   @default("")
  settingsJson String  @default("{}") // JSON blob for extra settings
  createdAt   DateTime @default(now())

  // Owner relation (nullable — meetings can be created by guests pre-auth)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id])

  // Children
  questions    Question[]
  polls        Poll[]
  participants Participant[]
  enrollments  MeetingEnrollment[]
  gracePeriod  GracePeriod?
}

// ── Questions ─────────────────────────────────────────────────────────────────

model Question {
  id                String   @id @default(cuid())
  text              String
  canonicalText     String
  membersJson       String   @default("[]")  // JSON array of member question strings
  votes             Int      @default(0)
  score             Float    @default(0)
  status            String   @default("Pending") // Pending | Under Review | Answered | Flagged
  askedByName       String   @default("")  // display name snapshot
  assignedSpeakerId String?
  summaryText       String   @default("")
  timelineJson      String   @default("[]") // JSON array of timeline strings
  embeddingJson     String?                // JSON-stringified float32 array from MiniLM — null until computed
  createdAt         DateTime @default(now())

  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  askedById  String?
  askedBy    User?   @relation("QuestionAskedBy", fields: [askedById], references: [id])

  votes_rel  Vote[]
  reactions  Reaction[]
}

// ── Polls ─────────────────────────────────────────────────────────────────────

model Poll {
  id         String   @id @default(cuid())
  question   String
  active     Boolean  @default(true)
  endsAt     DateTime?
  totalVotes Int      @default(0)
  createdAt  DateTime @default(now())

  meetingId  String
  meeting    Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  options    PollOption[]
}

model PollOption {
  id     String @id @default(cuid())
  label  String
  votes  Int    @default(0)

  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
}

// ── Participants ───────────────────────────────────────────────────────────────

model Participant {
  id             String @id @default(cuid())
  name           String
  initials       String @default("")
  upvotes        Int    @default(0)
  questionsCount Int    @default(0)
  role           String @default("participant") // owner | speaker | participant
  // Browser-generated UUID for anonymous attendees; null for authenticated users.
  // Used server-side only for duplicate-join detection — never exposed to other clients.
  guestToken     String?

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId  String?
  user    User?   @relation(fields: [userId], references: [id])
}

// ── Votes ─────────────────────────────────────────────────────────────────────
//
// Records one vote per (question, voter) pair. voterId is either:
//   • the authenticated User.id  (when userId is known), or
//   • the browser-generated guestToken (for anonymous attendees)
// The @@unique constraint is the hard guarantee against double-counting.

model Vote {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  voterId    String   // userId OR guestToken — opaque stable identity string
  createdAt  DateTime @default(now())

  @@unique([questionId, voterId])
}

// ── Reactions ─────────────────────────────────────────────────────────────────
// Records emoji reactions per (question, voter, emoji) triplet.
// voterId mirrors Vote.voterId: userId OR guestToken.
// The unique constraint prevents duplicate reactions of the same emoji.

model Reaction {
  id         String   @id @default(cuid())
  emoji      String   // "thumbsup" | "thinking" | "fire"
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  voterId    String
  createdAt  DateTime @default(now())

  @@unique([questionId, voterId, emoji])
}

// ── Notifications ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  type      String   // "Meeting Updates" | "Questions" | "System" | "Admin Message"
  title     String
  body      String
  time      String   @default("")
  read      Boolean  @default(false)
  source    String   @default("system") // "system" | "admin"
  senderId  String?  // set when source === "admin" — the admin/superadmin who sent it
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Auth tokens ───────────────────────────────────────────────────────────────

model ResetToken {
  // Store the SHA-256 hash of the raw token (never the raw token itself)
  tokenHash String   @id
  expiresAt DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Audit Log ─────────────────────────────────────────────────────────────────
// Records every significant admin action for compliance and debugging.

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String                      // who performed the action
  adminName   String
  adminRole   String
  action      String                      // e.g. "meeting.delete", "user.role_update"
  actionType  String   @default("info")   // "danger" | "warning" | "info" | "success"
  targetType  String                      // "Meeting" | "User" | "Question" | "SystemConfig"
  targetName  String
  targetId    String   @default("")
  detailJson  String   @default("{}")     // JSON blob with before/after context
  ipAddress   String   @default("")
  createdAt   DateTime @default(now())
}

// ── Meeting Enrollment ────────────────────────────────────────────────────────
// Created when an authenticated user joins a scheduled meeting via QR or code.
// This is what makes a meeting appear in the user's personal upcoming list.

model MeetingEnrollment {
  id         String   @id @default(cuid())
  enrolledAt DateTime @default(now())
  joinMethod String   @default("code")  // "qr" | "code"

  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])   // one enrollment per user per meeting
}

// ── Grace Period ──────────────────────────────────────────────────────────────
// Created when a scheduled meeting passes its scheduledAt without going live.
// The host has until graceEndsAt to extend or reschedule before auto-expiry.

model GracePeriod {
  id            String    @id @default(cuid())
  graceStartsAt DateTime
  graceEndsAt   DateTime  // graceStartsAt + GRACE_PERIOD_MINUTES
  hostAction    String?   // null | "extended" | "rescheduled" | "expired"
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  meetingId     String    @unique
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

// ── Meeting Templates ─────────────────────────────────────────────────────────
// Per-user saved meeting presets. Provides the "Start from template" dropdown
// in the Create Meeting flow. settingsJson stores arbitrary extra meeting settings.

model MeetingTemplate {
  id           String   @id @default(cuid())
  title        String   @default("")
  category     String   @default("")
  duration     String   @default("")
  settingsJson String   @default("{}")  // JSON blob
  createdAt    DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

// ── Admin Notifications ───────────────────────────────────────────────────────
// Admin-facing system alerts visible to all admins. No userId — not user-targeted.

model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // "system" | "user" | "meeting" | "security" | "content"
  priority  String   @default("medium") // "critical" | "high" | "medium" | "low"
  title     String
  body      String
  read      Boolean  @default(false)
  relatedId String   @default("")
  createdAt DateTime @default(now())
}

// ── Admin Messages ────────────────────────────────────────────────────────────
// Audit log of every message an admin sends to users. Kept separate from
// Notification so there is a clean record of what admins actually sent,
// independent of the per-user notification rows generated from it.
// recipientsJson stores a JSON array of userId strings (simpler than
// reconstructing the recipient list from notification join queries).

model AdminMessage {
  id             String   @id @default(cuid())
  senderId       String
  sender         User     @relation("MessagesSent", fields: [senderId], references: [id])
  subject        String
  body           String
  audience       String   // "single" | "all_users" | "meeting_participants" | "admins"
  targetUserId   String?  // set when audience === "single"
  meetingId      String?  // set when audience === "meeting_participants"
  recipientCount Int      @default(0)
  recipientsJson String   @default("[]") // JSON array of userId strings for audit trail
  createdAt      DateTime @default(now())
}

// ── Notification Preferences ──────────────────────────────────────────────────
// Per-user opt-in settings. Created on first PATCH; defaults are all-enabled.

model NotificationPreference {
  userId           String  @id
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingUpdates   Boolean @default(true)
  questionActivity Boolean @default(true)
  systemAlerts     Boolean @default(true)
  adminMessages    Boolean @default(true)
  emailDigest      Boolean @default(false)
}
