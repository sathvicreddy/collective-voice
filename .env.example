# CollectiveVoice — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────
# Required in production — must be a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cv_dev_secret_change_in_prod

# Access token lifetime (e.g. "1h", "15m"). Shorter = more secure.
JWT_EXPIRES=1h

# Refresh token lifetime in days
REFRESH_TTL_DAYS=30

# ── Rate Limiting ────────────────────────────────────────────
# Max login/signup attempts per IP per window
RATE_LIMIT_MAX_REQUESTS=5
# Window length in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ── NLP Engine ────────────────────────────────────────────────
# Cosine similarity threshold for question clustering (0.0 – 1.0).
# Uses Xenova/all-MiniLM-L6-v2 sentence embeddings.
# 0.60 sits between paraphrases (0.65-0.85) and distinct topics (0.20-0.45).
# Falls back to Dice coefficient (use 0.40) if model download fails.
NLP_THRESHOLD=0.60

# Scoring weights (must sum to 1.0)
SCORE_ALPHA=0.40   # Vote normalisation weight
SCORE_BETA=0.25    # Temporal freshness weight
SCORE_GAMMA=0.20   # Content novelty weight
SCORE_DELTA=0.15   # Topical diversity weight
SCORE_LAMBDA=0.50  # Freshness decay rate per hour

# ── Database ────────────────────────────────────────────────────
# SQLite for local dev. Swap to postgres://user:pass@host:5432/dbname for prod
# (only requires changing provider in prisma/schema.prisma + this URL).
DATABASE_URL=file:./dev.db

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In development, all localhost ports are allowed automatically.
# In production set this to your exact domain(s).
# Example: https://collectivevoice.app,https://www.collectivevoice.app
ALLOWED_ORIGINS=http://localhost:3000

# ── Admin Bootstrap ───────────────────────────────────────────────
# Email that is auto-promoted to superadmin on first login (Google or email).
# Required for admin panel access. Change to your own email.
SUPERADMIN_EMAIL=your_admin@email.com

# ── Google OAuth ──────────────────────────────────────────────
# Obtain credentials at https://console.cloud.google.com → APIs & Services → Credentials.
# If these three vars are unset, GET /api/auth/google returns 501 — the app still boots.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Node environment ──────────────────────────────────────────
# Set to "production" to enable startup safety checks.
NODE_ENV=development
