# .env.production.example — CollectiveVoice
# Copy to .env on your server / paste into Render dashboard.
# ⚠️  NEVER commit .env (it is in .gitignore).

# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Database — Neon PostgreSQL ──────────────────────────────────
# Get this from: https://console.neon.tech → Your Project → Connection string
# Use the "Pooled connection" URL (starts with postgres://...@ep-...pooler....)
DATABASE_URL=postgresql://user:password@ep-xxxx.pooler.neon.tech/neondb?sslmode=require

# ── Auth ──────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES=1h
REFRESH_TTL_DAYS=30

# ── CORS ──────────────────────────────────────────────────────
# Set to your Render URL (no trailing slash)
# After first deploy: https://collectivevoice.onrender.com
ALLOWED_ORIGINS=https://collectivevoice.onrender.com

# ── Admin ─────────────────────────────────────────────────────
# The email that gets auto-promoted to superadmin on first login
SUPERADMIN_EMAIL=your_admin@email.com

# ── NLP Engine ────────────────────────────────────────────────
NLP_THRESHOLD=0.60
SCORE_ALPHA=0.40
SCORE_BETA=0.25
SCORE_GAMMA=0.20
SCORE_DELTA=0.15
SCORE_LAMBDA=0.50

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=900000

# ── Google OAuth (optional) ───────────────────────────────────
# Obtain at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: https://collectivevoice.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
