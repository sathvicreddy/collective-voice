# CollectiveVoice — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────
PORT=3000

# ── Auth ──────────────────────────────────────────────────────
# Required in production — must be a long random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cv_dev_secret_change_in_prod

# Access token lifetime (e.g. "1h", "15m"). Shorter = more secure.
JWT_EXPIRES=1h

# Refresh token lifetime in days
REFRESH_TTL_DAYS=30

# ── Rate Limiting ────────────────────────────────────────────
# Max login/signup attempts per IP per window
RATE_LIMIT_MAX_REQUESTS=5
# Window length in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# ── NLP Engine ────────────────────────────────────────────────
# Cosine similarity threshold for question clustering (0.0 – 1.0).
# Upgraded from Dice (0.40) to cosine (MiniLM). 0.60 sits cleanly between
# same-meaning paraphrases (0.65-0.85) and distinct topics (0.20-0.45).
NLP_THRESHOLD=0.60

# Scoring weights (must sum to 1.0)
SCORE_ALPHA=0.40   # Vote normalisation weight
SCORE_BETA=0.25    # Temporal freshness weight
SCORE_GAMMA=0.20   # Content novelty weight
SCORE_DELTA=0.15   # Topical diversity weight
SCORE_LAMBDA=0.50  # Freshness decay rate per hour

# ── Database ────────────────────────────────────────────────────
# SQLite for dev. Swap to postgres://user:pass@host:5432/collectivevoice for prod.
DATABASE_URL=file:./dev.db

# ── Google OAuth ─────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com → APIs & Services → Credentials.
# If unset, GET /api/auth/google returns 501 (not a crash).
GOOGLE_CLIENT_ID=844470072865-lvtrjn624aniknhd2glk0h5cuei7igtc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
