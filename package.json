{
  "name": "collectivevoice-web-app",
  "version": "1.0.0",
  "description": "Responsive CollectiveVoice frontend and backend prototype.",
  "main": "backend/server.js",
  "scripts": {
    "start": "node -r dotenv/config backend/server.js",
    "backend": "node -r dotenv/config backend/server.js",
    "dev": "node -r dotenv/config backend/server.js",
    "test": "jest --testPathPattern=backend/tests --forceExit",
    "test:api": "jest --testPathPattern=backend/tests/api --forceExit",
    "test:auth": "jest --testPathPattern=backend/tests/auth --forceExit",
    "test:nlp": "jest --testPathPattern=backend/tests/nlp --forceExit",
    "test:db": "jest --testPathPattern=backend/tests/db --forceExit",
    "test:watch": "jest --testPathPattern=backend/tests --watch",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "keywords": [
    "collectivevoice",
    "qna",
    "meetings"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "supertest": "^6.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000,
    "setupFiles": [
      "./backend/tests/setup.js"
    ]
  }
}
